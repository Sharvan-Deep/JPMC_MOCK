# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/jaldhaara

# JWT Authentication
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins; required for credentialed cross-origin requests)
CORS_ORIGINS=http://localhost:3000

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Google OAuth (used in a later auth module)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email OTP (used in a later auth module)
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_HASH_SECRET=change-me-to-a-long-random-secret

# Email (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-gmail-address@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_NAME=Jaldhaara

# Optional: default recipient for `npm run test:mail` when no CLI arg is given
MAIL_TEST_RECIPIENT=

# Company CSV import
# Default path relative to project root; override for custom locations
COMPANY_CSV_PATH=data/03_company_ai_ready_summary.csv
CSR_ACTIVITY_CSV_PATH=data/csr_activities.csv

# Frontend (invitation activation links)
FRONTEND_URL=http://localhost:3000

# Invitations
INVITATION_EXPIRY_HOURS=72
INVITATION_RESEND_COOLDOWN_MINUTES=5
PASSWORD_MIN_LENGTH=8
SUPPORT_EMAIL=support@jaldhaara.org

# Password reset
PASSWORD_RESET_EXPIRES_HOURS=1
PASSWORD_RESET_COOLDOWN_MINUTES=5

# Python AI service (Node is the authenticated gateway; do not put model/Chroma keys here)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000
ALLOW_ADMIN_BOOTSTRAP=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
