# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/jaldhaara

# JWT (used in a later auth module)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google OAuth (used in a later auth module)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email OTP (used in a later auth module)
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_HASH_SECRET=change-me-to-a-long-random-secret

# Email (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-gmail-address@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM_NAME=Jaldhaara

# Optional: default recipient for `npm run test:mail` when no CLI arg is given
MAIL_TEST_RECIPIENT=

# Company CSV import
# Default path relative to project root; override for custom locations
COMPANY_CSV_PATH=data/03_company_ai_ready_summary.csv
