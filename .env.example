# ==============================================================================
# JALDHAARA FOUNDATION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE.JS BACKEND (Express + MongoDB)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/jaldhaara

# JWT & Authentication
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_HASH_SECRET=change-me-to-a-long-random-secret

# Company CSV Import
COMPANY_CSV_PATH=data/03_company_ai_ready_summary.csv

# ------------------------------------------------------------------------------
# 2. PYTHON AI/DATA SERVICE (FastAPI)
# ------------------------------------------------------------------------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development
DOCUMENTS_STORAGE_PATH=data/documents
LOG_LEVEL=INFO

# Future AI/LLM & Vector DB Placeholders (Do NOT commit real API keys)
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_COLLECTION=csr_documents
